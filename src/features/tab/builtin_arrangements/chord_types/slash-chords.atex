\title "Slash chords"
\ts (4 4)
\chord ("G" 3 0 0 0 2 3)
\chord ("D/F#" 2 3 2 0 x 2)
\chord ("Em" 0 0 0 2 2 0)
\chord ("C" 0 1 0 2 3 x)
\chord ("C/G" 0 1 0 2 3 3)
\chord ("Am" 0 1 2 2 0 x)
\chord ("Am/G" 0 1 2 2 0 3)
\chord ("G/B" 3 0 0 0 2 x)
(3.1 0.2 0.3 0.4 2.5 3.6).2{ch "G" sd}
  (2.1 3.2 2.3 0.4 2.6).2{ch "D/F#" txt "Bass walks down" sd} |
(0.1 0.2 0.3 2.4 2.5 0.6).2{ch "Em" sd}
  (0.1 1.2 0.3 2.4 3.5 3.6).2{ch "C/G" sd} |
(0.1 1.2 2.3 2.4 0.5).2{ch "Am" sd} (0.1 1.2 2.3 2.4 0.5 3.6).2{ch "Am/G" sd} |
(0.1 1.2 0.3 2.4 3.5).2{ch "C" sd} (3.1 0.2 0.3 0.4 2.5).2{ch "G/B" sd} |

