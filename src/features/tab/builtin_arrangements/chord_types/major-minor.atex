\title "Major and minor chords"
\ts (4 4)
\chord ("C" 0 1 0 2 3 x)
\chord ("G" 3 0 0 0 2 3)
\chord ("D" 2 3 2 0 x x)
\chord ("A" 0 2 2 2 0 x)
\chord ("E" 0 0 1 2 2 0)
\chord ("Am" 0 1 2 2 0 x)
\chord ("Em" 0 0 0 2 2 0)
\chord ("Dm" 1 3 2 0 x x)
\chord ("F" 1 1 2 3 3 1)
\chord ("Bm" 2 3 4 4 2 x)
(0.1 1.2 0.3 2.4 3.5).2{ch "C" txt "Open major" sd}
  (3.1 0.2 0.3 0.4 2.5 3.6).2{ch "G" sd} |
(2.1 3.2 2.3 0.4).2{ch "D" sd} (0.1 2.2 2.3 2.4 0.5).2{ch "A" sd} |
(0.1 0.2 1.3 2.4 2.5 0.6).1{ch "E" sd} |
(0.1 1.2 2.3 2.4 0.5).2{ch "Am" txt "Open minor" sd}
  (0.1 0.2 0.3 2.4 2.5 0.6).2{ch "Em" sd} |
(1.1 3.2 2.3 0.4).1{ch "Dm" sd} |
(1.1 1.2 2.3 3.4 3.5 1.6).2{ch "F" txt "Barre" sd}
  (2.1 3.2 4.3 4.4 2.5).2{ch "Bm" sd} |

