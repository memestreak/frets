\title "Diminished and augmented chords"
\ts (4 4)
\chord ("C" 0 1 0 2 3 x)
\chord ("Caug" 0 1 1 2 3 x)
\chord ("Am" 0 1 2 2 0 x)
\chord ("Cdim7" x 4 2 4 3 x)
\chord ("G" 3 0 0 0 2 3)
\chord ("G#dim7" 1 0 1 0 x 4)
(0.1 1.2 0.3 2.4 3.5).2{ch "C" sd}
  (0.1 1.2 1.3 2.4 3.5).2{ch "Caug" txt "Augmented" sd} |
(0.1 1.2 2.3 2.4 0.5).1{ch "Am" sd} |
(4.2 2.3 4.4 3.5).2{ch "Cdim7" txt "Diminished 7" sd}
  (3.1 0.2 0.3 0.4 2.5 3.6).2{ch "G" sd} |
(1.1 0.2 1.3 0.4 4.6).2{ch "G#dim7" sd} (0.1 1.2 2.3 2.4 0.5).2{ch "Am" sd} |

