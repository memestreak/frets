\title "Sixth and ninth chords"
\ts (4 4)
\chord ("C6" 0 1 2 2 3 x)
\chord ("G6" 0 0 0 0 2 3)
\chord ("A6" 2 2 2 2 0 x)
\chord ("E9" 2 0 1 0 2 0)
\chord ("C9" 3 3 3 2 3 x)
\chord ("D9" 5 5 5 4 5 x)
(0.1 1.2 2.3 2.4 3.5).2{ch "C6" txt "Sixths" sd}
  (0.1 0.2 0.3 0.4 2.5 3.6).2{ch "G6" sd} |
(2.1 2.2 2.3 2.4 0.5).1{ch "A6" sd} |
(2.1 0.2 1.3 0.4 2.5 0.6).2{ch "E9" txt "Ninths" sd}
  (3.1 3.2 3.3 2.4 3.5).4{ch "C9" sd} (5.1 5.2 5.3 4.4 5.5).4{ch "D9" sd} |

