\title "Down-up eighths"
\ts (4 4)
\chord ("C" 0 1 0 2 3 x)
\chord ("Am" 0 1 2 2 0 x)
\chord ("F" 1 1 2 3 3 1)
\chord ("G" 3 0 0 0 2 3)
(0.1 1.2 0.3 2.4 3.5).8{ch "C" txt "1 & 2 & 3 & 4 &" sd}
  (0.1 1.2 0.3 2.4 3.5).8{su} (0.1 1.2 0.3 2.4 3.5).8{sd}
  (0.1 1.2 0.3 2.4 3.5).8{su} (0.1 1.2 0.3 2.4 3.5).8{sd}
  (0.1 1.2 0.3 2.4 3.5).8{su} (0.1 1.2 0.3 2.4 3.5).8{sd}
  (0.1 1.2 0.3 2.4 3.5).8{su} |
(0.1 1.2 2.3 2.4 0.5).8{ch "Am" sd} (0.1 1.2 2.3 2.4 0.5).8{su}
  (0.1 1.2 2.3 2.4 0.5).8{sd} (0.1 1.2 2.3 2.4 0.5).8{su}
  (0.1 1.2 2.3 2.4 0.5).8{sd} (0.1 1.2 2.3 2.4 0.5).8{su}
  (0.1 1.2 2.3 2.4 0.5).8{sd} (0.1 1.2 2.3 2.4 0.5).8{su} |
(1.1 1.2 2.3 3.4 3.5 1.6).8{ch "F" sd} (1.1 1.2 2.3 3.4 3.5 1.6).8{su}
  (1.1 1.2 2.3 3.4 3.5 1.6).8{sd} (1.1 1.2 2.3 3.4 3.5 1.6).8{su}
  (1.1 1.2 2.3 3.4 3.5 1.6).8{sd} (1.1 1.2 2.3 3.4 3.5 1.6).8{su}
  (1.1 1.2 2.3 3.4 3.5 1.6).8{sd} (1.1 1.2 2.3 3.4 3.5 1.6).8{su} |
(3.1 0.2 0.3 0.4 2.5 3.6).8{ch "G" sd} (3.1 0.2 0.3 0.4 2.5 3.6).8{su}
  (3.1 0.2 0.3 0.4 2.5 3.6).8{sd} (3.1 0.2 0.3 0.4 2.5 3.6).8{su}
  (3.1 0.2 0.3 0.4 2.5 3.6).8{sd} (3.1 0.2 0.3 0.4 2.5 3.6).8{su}
