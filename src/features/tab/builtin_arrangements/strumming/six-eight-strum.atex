\title "Six-eight strum"
\ts (6 8)
\chord ("Em" 0 0 0 2 2 0)
\chord ("C" 0 1 0 2 3 x)
\chord ("G" 3 0 0 0 2 3)
\chord ("D" 2 3 2 0 x x)
