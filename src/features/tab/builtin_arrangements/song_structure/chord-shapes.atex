\title "Chord shapes"
\ts (4 4)
\chord ("C" 0 1 0 2 3 x)
\chord ("Am7" 0 1 0 2 0 x) {showfingering false}
\chord ("F" 1 1 2 3 3 1) {firstfret 1 barre 1}
\chord ("G" 3 0 0 0 2 3) {showdiagram true showname true}
\chord ("A7" 0 2 0 2 0 x) {showdiagram false}
(0.1 1.2 0.3 2.4 3.5).2{ch "C" sd} (0.1 1.2 0.3 2.4 0.5).2{ch "Am7" sd} |
(1.1 1.2 2.3 3.4 3.5 1.6).2{ch "F" sd} (3.1 0.2 0.3 0.4 2.5 3.6).2{ch "G" sd} |
r.1{ch "N.C."} |

