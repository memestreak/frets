\title "Lead sheet"
\ts (4 4)
\chord ("G" 3 0 0 0 2 3)
\chord ("D" 2 3 2 0 x x)
\chord ("Em" 0 0 0 2 2 0)
\chord ("C" 0 1 0 2 3 x)
\chord ("Am7" 0 1 0 2 0 x)
\section "Verse"
  (3.1 0.2 0.3 0.4 2.5 3.6).4{ch "G" txt "1. Press Lead sheet (top left): a box per bar. Bar 2 says G again; bar 5 is silent, an empty box"}
  (3.1 0.2 0.3 0.4 2.5 3.6).4 (3.1 0.2 0.3 0.4 2.5 3.6).4
  (3.1 0.2 0.3 0.4 2.5 3.6).4 |
(3.1 0.2 0.3 0.4 2.5 3.6).2 (3.1 0.2 0.3 0.4 2.5 3.6).2 |
(2.1 3.2 2.3 0.4).2{ch "D" txt "2. Two chords: Em at beat 3"}
  (0.1 0.2 0.3 2.4 2.5 0.6).2{ch "Em"} |
(0.1 0.2 0.3 2.4 2.5 0.6).2{txt "3. Em again, then C halfway"}
  (0.1 1.2 0.3 2.4 3.5).2{ch "C"} |
r.1 |
(0.1 1.2 0.3 2.4 0.5).1{ch "Am7" txt "4. Click Am7: blue. Delete key takes it away, Ctrl+Z brings it back. Double-click it: the Chords panel opens on Am7"} |
\section "Chorus" \ro
  (3.1 0.2 0.3 0.4 2.5 3.6).4{ch "G" txt "5. Click beat 3 of a box: the blue caret goes there. Right arrow key moves it a note. Press C, type F, Enter" lyrics "Sing"}
  (3.1 0.2 0.3 0.4 2.5 3.6).8{lyrics "a-"}
  (3.1 0.2 0.3 0.4 2.5 3.6).8{lyrics "gain"}
  (2.1 3.2 2.3 0.4).4{ch "D" lyrics "and"} (2.1 3.2 2.3 0.4).4{lyrics "a-"} |
\ae 1 \rc 2
  (0.1 1.2 0.3 2.4 3.5).1{ch "C" txt "6. Space plays: a line moves through the boxes" lyrics "gain,"} |
\ae 2 (2.1 3.2 2.3 0.4).1{ch "D" lyrics "home."} |
\ts (6 8) \section "Outro"
  (3.1 0.2 0.3 0.4 2.5 3.6).4{d ch "G" txt "7. 6/8 from here: two beats a bar. Export (the arrow over the clip): the PNG draws this grid"}
  (3.1 0.2 0.3 0.4 2.5 3.6).4{d} |
(0.1 0.2 0.3 2.4 2.5 0.6).4{d ch "Em"}
  (0.1 1.2 0.3 2.4 3.5).4{d ch "C" txt "8. The Chorus row has words under it: the Lyrics. Type them in the Tab view with Shift+L"} |

