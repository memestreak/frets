\title "1. Enter notes"
\ts (4 4)
r.1{txt "Tab view. 1. Press N."} |
r.1{txt "2. Type 0, then the Right arrow key."} |
r.1{txt "3. Type 3, 5 and 7 the same way."} |
r.1{txt "4. Shift+4: eighths from now on."} |
r.1{txt "5. Down arrow key: the B string."} |
r.1{txt "6. Type 1, Right arrow, 3, Right arrow."} |
r.1{txt "7. Esc ends note input mode."} |
r.1{txt "8. Space plays. ? lists every key."} |

