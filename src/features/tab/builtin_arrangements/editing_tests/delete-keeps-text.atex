\title "Delete keeps a column's text and chord name"
\ts (4 4)
0.6.4
  3.6.4{ch "Am" txt "1. Both view: on the tab, press this 3, then the Delete key. It turns into a quarter rest, and this text and Am stay over it"}
  5.6.2 |
3.6.4
  (2.3 2.4).4{txt "2. Press the 3 before this chord, then the Right arrow key (the chord lights), then the Delete key. Both notes go, and this text stays over the rest"}
  5.6.2 |
3.6.4
  5.6.4{txt "3. Press this 5, then Shift+Right arrow key and Ctrl/⌘+X (cut). Both notes go, and this text stays over the first rest"}
  7.6.4 5.6.4 |
0.6.2
  5.6.2{txt "4. Press this 5, then the Delete key, then Ctrl/⌘+Delete. That takes the time away, and this text goes with it"} |

