\voice
  0.1.4{txt "Tab view: voice 1's stems go over the tab, voice 2's under it. Press any note: the other voice turns grey"}
  r.4 3.2.2 \voice 0.6.4 0.6.4 2.4.4 r.4 |
0.1.1{txt "Voice 1 alone: its stems under the tab, as always"} |

