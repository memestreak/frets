\title "A chord from picked notes"
\ts (4 4)
\capo 2
r.1{txt "**1.** Select Tab view\nTab, at the top left of the clip"} |
0.5.8{txt "**2.** Pick the arpeggio\nPress this 0, then Shift+Right arrow key 3 times"}
  2.4.8 2.3.8 1.2.8
  r.2{txt "**3.** Name it\nRight-click, Chord from notes: Am over the 0"} |
(5.1 5.2 5.3 7.4).4{txt "**4.** Name a chord at fret 5\nRight-click this 5, Chord from notes"}
  r.4 r.2{txt "**5.** Check its name\nAm 2: the Am shape at fret 5"} |
5.1.4{txt "**6.** Try one note\nRight-click this 5, Chord from notes"} r.4
  r.2{txt "**7.** Read why\nThe line under the clip says why not"} |

